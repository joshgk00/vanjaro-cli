# Copy to .env and fill in your values (never commit .env)
VANJARO_BASE_URL=https://your-site.com
VANJARO_USERNAME=admin
VANJARO_PASSWORD=changeme

# Optional: portal ID if multi-site (default: 0)
VANJARO_PORTAL_ID=0

# Figma personal access token (figma.com > Settings > Personal access tokens)
# Required for: vanjaro figma inspect|tokens|export
FIGMA_ACCESS_TOKEN=

# OpenAI Responses API key for automatic screenshot/reference-image evidence.
# The key is read only at execution time and is never written to project artifacts.
OPENAI_API_KEY=

# Optional vision-capable structured-output model override.
VANJARO_IMAGE_EVIDENCE_MODEL=gpt-5.4

# Optional local registry override for versioned agency packs.
VANJARO_AGENCY_PACKS_DIR=
