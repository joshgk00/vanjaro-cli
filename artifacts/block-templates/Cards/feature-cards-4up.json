{
  "name": "Feature Cards (4-up)",
  "category": "Cards",
  "description": "Four equal-width cards with icon, heading, and text for showcasing services or features",
  "capabilities": {
    "schema_version": "1.1",
    "roles": [
      "feature_cards",
      "service_cards"
    ],
    "layout": {
