      "media_positions": [
        "top",
        "none"
      ],
      "alignment": [
        "left",
        "center"
      ]
    },
    "repeat_group": {
      "kind": "card",
      "minimum": 1,
      "default": 4,
      "maximum": 12,
      "expandable": true
    },
    "fields": {
      "item.title": "required",
      "item.body": "optional"
    },
