          "heading_1",
          "heading_2",
          "heading_3",
          "heading_4"
        ],
        "slots_per_owner": 1
      },
      "item.body": {
        "owner": "repeat_item",
        "slot_type": "text",
        "slots": [
          "text_1",
          "text_2",
          "text_3",
          "text_4"
        ],
        "slots_per_owner": 1
      }
    },
    "responsive": {
      "desktop_columns": 4,
      "tablet_columns": 2,
      "mobile_columns": 1,
      "stacking_order": "source"
    },
    "interactions": [],
    "native_component_ratio": 1.0,
