{
  "name": "Photo Band",
  "category": "Heroes",
  "description": "Full-bleed background-photo band with a baked min-height and no overlay text, for hero/CTA photos that already carry their own text",
  "capabilities": {
    "schema_version": "1.1",
    "roles": [
      "photo_band",
      "hero_media",
      "cta_media"
    ],
    "layout": {
      "kind": "band",
      "columns": [
        1
      ],
      "media_positions": [
        "background"
      ],
      "alignment": [
        "center"
      ]
    },
    "repeat_group": null,
    "fields": {
      "background_media": "required"
    },
    "physical_fields": {
      "background_media": {
        "owner": "section",
        "slot_type": "section",
        "slots": [
          "background_image"
        ],
        "slots_per_owner": 1
      }
    },
    "responsive": {
      "desktop_columns": 1,
      "tablet_columns": 1,
      "mobile_columns": 1,
      "stacking_order": "source"
    },
    "interactions": [],
    "native_component_ratio": 1.0,
    "supported_modifiers": [
      "background-image",
      "background-overlay",
      "image-focal-point",
      "media-aspect",
      "spacing"
    ]
  },
  "template": {
    "type": "section",
    "classes": [
      {"name": "vj-section", "active": false},
      {"name": "p-0", "active": false}
    ],
    "attributes": {"id": "tpl-pb-s1", "style": "min-height:60vh;background-size:cover;background-position:center;"},
    "components": [
      {
        "type": "grid",
        "classes": [
          {"name": "container-fluid", "active": false},
          {"name": "p-0", "active": false}
        ],
        "attributes": {"id": "tpl-pb-g1"},
        "components": [
          {
            "type": "row",
            "classes": [
              {"name": "row", "active": false},
              {"name": "g-0", "active": false}
            ],
            "attributes": {"id": "tpl-pb-r1"},
            "components": [
              {
                "type": "column",
                "classes": [
                  {"name": "col-12", "active": false}
                ],
                "attributes": {"id": "tpl-pb-c1", "style": "min-height:60vh;"},
                "components": [
                  {
                    "type": "spacer",
                    "classes": [
                      {"name": "spacer", "active": false}
                    ],
                    "attributes": {"id": "tpl-pb-sp1", "style": "min-height:60vh;"}
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "styles": []
}
