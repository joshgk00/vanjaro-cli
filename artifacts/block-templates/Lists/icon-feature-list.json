        "slots": [
          "text_1",
          "text_2",
          "text_3"
        ],
        "slots_per_owner": 1
      },
      "item.media": {
        "owner": "repeat_item",
        "slot_type": "image",
        "slots": [
          "image_1_src",
          "image_2_src",
          "image_3_src"
        ],
        "slots_per_owner": 1
      }
    },
    "responsive": {
