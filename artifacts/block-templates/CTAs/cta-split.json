{
  "name": "CTA Split",
  "category": "CTAs",
  "description": "Two-column CTA with heading, optional subtitle and text, plus optional media and action",
  "capabilities": {
    "schema_version": "1.1",
    "roles": [
      "cta",
      "cta_split"
    ],
    "layout": {
      "kind": "split",
      "columns": [
        2
      ],
      "media_positions": [
        "none",
        "right"
      ],
      "alignment": [
        "left",
        "right"
      ]
    },
    "repeat_group": null,
    "fields": {
      "title": "required",
      "subtitle": "optional",
      "body": "optional",
      "media": "optional",
      "action": "optional"
    },
    "physical_fields": {
      "title": {
        "owner": "section",
        "slot_type": "heading",
        "slots": [
          "heading_1"
        ],
        "slots_per_owner": 1
      },
      "subtitle": {
        "owner": "section",
        "slot_type": "heading",
        "slots": [
          "heading_2"
        ],
        "slots_per_owner": 1
      },
      "body": {
        "owner": "section",
        "slot_type": "text",
        "slots": [
          "text_1"
        ],
        "slots_per_owner": 1
      },
      "media": {
        "owner": "section",
        "slot_type": "image",
        "slots": [
          "image_1_src"
        ],
        "slots_per_owner": 1
      },
      "action": {
        "owner": "section",
        "slot_type": "button",
        "slots": [
          "button_1"
        ],
        "slots_per_owner": 1
      }
    },
    "responsive": {
      "desktop_columns": 2,
      "tablet_columns": 2,
      "mobile_columns": 1,
      "stacking_order": "source"
    },
    "interactions": [
      "link"
    ],
    "native_component_ratio": 1.0,
    "supported_modifiers": [
      "band-color",
      "button-style",
      "content-width",
      "spacing",
      "text-alignment",
      "background-image",
      "background-overlay",
      "column-gap"
    ]
  },
  "template": {
    "type": "section",
    "classes": [
      {"name": "vj-section", "active": false},
      {"name": "py-5", "active": false}
    ],
    "attributes": {"id": "tpl-ctas-s1"},
    "components": [
      {
        "type": "grid",
        "classes": [
          {"name": "container", "active": false}
        ],
        "attributes": {"id": "tpl-ctas-g1"},
        "components": [
          {
            "type": "row",
            "classes": [
              {"name": "row", "active": false},
              {"name": "align-items-center", "active": false},
              {"name": "g-4", "active": false}
            ],
            "attributes": {"id": "tpl-ctas-r1"},
            "components": [
              {
                "type": "column",
                "classes": [
                  {"name": "col-xl-8", "active": false},
                  {"name": "col-md-8", "active": false},
                  {"name": "col-12", "active": false}
                ],
                "attributes": {"id": "tpl-ctas-c1"},
                "components": [
                  {
                    "type": "heading",
                    "tagName": "h2",
                    "content": "Ready to Take the Next Step?",
                    "classes": [
                      {"name": "vj-heading", "active": false},
                      {"name": "head-style-2", "active": false},
                      {"name": "mb-0", "active": false}
                    ],
                    "attributes": {"id": "tpl-ctas-h1"}
                  },
                  {
                    "type": "heading",
                    "tagName": "h4",
                    "content": "A supporting call-to-action subtitle",
                    "classes": [
                      {"name": "vj-heading", "active": false},
                      {"name": "head-style-4", "active": false},
                      {"name": "mt-2", "active": false}
                    ],
                    "attributes": {"id": "tpl-ctas-h2"}
                  },
                  {
                    "type": "text",
                    "content": "Get in touch with our team and see how we can help you achieve your goals.",
                    "classes": [
                      {"name": "vj-text", "active": false},
                      {"name": "paragraph-style-1", "active": false},
                      {"name": "mt-2", "active": false},
                      {"name": "mb-0", "active": false}
                    ],
                    "attributes": {"id": "tpl-ctas-t1"}
                  }
                ]
              },
              {
                "type": "column",
                "classes": [
                  {"name": "col-xl-4", "active": false},
                  {"name": "col-md-4", "active": false},
                  {"name": "col-12", "active": false},
                  {"name": "text-center", "active": false}
                ],
                "attributes": {"id": "tpl-ctas-c2"},
                "components": [
                  {
                    "type": "image",
                    "classes": [
                      {"name": "image-box", "active": false},
                      {"name": "vj-image", "active": false},
                      {"name": "img-fluid", "active": false},
                      {"name": "mb-3", "active": false}
                    ],
                    "attributes": {
                      "id": "tpl-ctas-i1",
                      "src": "https://placehold.co/480x360",
                      "alt": "Call-to-action illustration"
                    }
                  },
                  {
                    "type": "button",
                    "tagName": "a",
                    "content": "Contact Us",
                    "classes": [
                      {"name": "btn", "active": false},
                      {"name": "btn-primary", "active": false},
                      {"name": "button-style-1", "active": false}
                    ],
                    "attributes": {"id": "tpl-ctas-b1", "role": "button", "href": "#"}
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "styles": []
}
