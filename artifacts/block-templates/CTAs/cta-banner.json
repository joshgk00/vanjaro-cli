{
  "name": "CTA Banner",
  "category": "CTAs",
  "description": "Centered call-to-action banner with heading, optional subtitle, supporting text, button, and optional background media",
  "capabilities": {
    "schema_version": "1.1",
    "roles": [
      "cta",
      "cta_banner"
    ],
    "layout": {
      "kind": "single",
      "columns": [
        1
      ],
      "media_positions": [
        "none",
        "background"
      ],
      "alignment": [
        "center"
      ]
    },
    "repeat_group": null,
    "fields": {
      "title": "required",
      "subtitle": "optional",
      "body": "optional",
      "action": "required",
      "background_media": "optional"
    },
    "physical_fields": {
      "title": {
        "owner": "section",
        "slot_type": "heading",
        "slots": [
          "heading_1"
        ],
        "slots_per_owner": 1
      },
      "subtitle": {
        "owner": "section",
        "slot_type": "heading",
        "slots": [
          "heading_2"
        ],
        "slots_per_owner": 1
      },
      "body": {
        "owner": "section",
        "slot_type": "text",
        "slots": [
          "text_1"
        ],
        "slots_per_owner": 1
      },
      "action": {
        "owner": "section",
        "slot_type": "button",
        "slots": [
          "button_1"
        ],
        "slots_per_owner": 1
      },
      "background_media": {
        "owner": "section",
        "slot_type": "section",
        "slots": [
          "background_image"
        ],
        "slots_per_owner": 1
      }
    },
    "responsive": {
      "desktop_columns": 1,
      "tablet_columns": 1,
      "mobile_columns": 1,
      "stacking_order": "source"
    },
    "interactions": [
      "link"
    ],
    "native_component_ratio": 1.0,
    "supported_modifiers": [
      "band-color",
      "button-style",
      "content-width",
      "spacing",
      "text-alignment",
      "background-image",
      "background-overlay"
    ]
  },
  "template": {
    "type": "section",
    "classes": [
      {"name": "vj-section", "active": false},
      {"name": "py-5", "active": false}
    ],
    "attributes": {"id": "tpl-ctab-s1"},
    "components": [
      {
        "type": "grid",
        "classes": [
          {"name": "container", "active": false}
        ],
        "attributes": {"id": "tpl-ctab-g1"},
        "components": [
          {
            "type": "row",
            "classes": [
              {"name": "row", "active": false},
              {"name": "justify-content-center", "active": false}
            ],
            "attributes": {"id": "tpl-ctab-r1"},
            "components": [
              {
                "type": "column",
                "classes": [
                  {"name": "col-xl-8", "active": false},
                  {"name": "col-md-10", "active": false},
                  {"name": "col-12", "active": false},
                  {"name": "text-center", "active": false}
                ],
                "attributes": {"id": "tpl-ctab-c1"},
                "components": [
                  {
                    "type": "heading",
                    "tagName": "h2",
                    "content": "Ready to Get Started?",
                    "classes": [
                      {"name": "vj-heading", "active": false},
                      {"name": "head-style-2", "active": false}
                    ],
                    "attributes": {"id": "tpl-ctab-h1"}
                  },
                  {
                    "type": "heading",
                    "tagName": "h4",
                    "content": "A supporting call-to-action subtitle",
                    "classes": [
                      {"name": "vj-heading", "active": false},
                      {"name": "head-style-4", "active": false},
                      {"name": "mt-2", "active": false}
                    ],
                    "attributes": {"id": "tpl-ctab-h2"}
                  },
                  {
                    "type": "text",
                    "content": "Join thousands of satisfied customers. Start your free trial today — no credit card required.",
                    "classes": [
                      {"name": "vj-text", "active": false},
                      {"name": "paragraph-style-1", "active": false},
                      {"name": "mt-3", "active": false}
                    ],
                    "attributes": {"id": "tpl-ctab-t1"}
                  },
                  {
                    "type": "button",
                    "tagName": "a",
                    "content": "Start Free Trial",
                    "classes": [
                      {"name": "btn", "active": false},
                      {"name": "btn-primary", "active": false},
                      {"name": "button-style-1", "active": false},
                      {"name": "mt-4", "active": false}
                    ],
                    "attributes": {"id": "tpl-ctab-b1", "role": "button", "href": "#"}
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "styles": []
}
