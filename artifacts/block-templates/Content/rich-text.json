{
  "name": "Rich Text Block",
  "category": "Content",
  "description": "Generic content section — heading plus paragraphs. Fallback template for sections with no specific layout.",
  "capabilities": {
    "schema_version": "1.1",
    "roles": [
      "rich_text",
      "content"
    ],
    "layout": {
      "kind": "single",
      "columns": [
        1
      ],
      "media_positions": [
        "none",
        "top"
      ],
      "alignment": [
        "left",
        "center"
      ]
    },
    "repeat_group": null,
    "fields": {
      "title": "optional",
      "media": "optional",
      "body": "required"
    },
    "physical_fields": {
      "media": {
        "owner": "section",
        "slot_type": "image",
        "slots": [
          "image_1_src"
        ],
        "slots_per_owner": 1
      },
      "title": {
        "owner": "section",
        "slot_type": "heading",
        "slots": [
          "heading_1"
        ],
        "slots_per_owner": 1
      },
      "body": {
        "owner": "section",
        "slot_type": "text",
        "slots": [
          "text_1",
          "text_2",
          "text_3",
          "text_4"
        ],
        "slots_per_owner": 4
      }
    },
    "responsive": {
      "desktop_columns": 1,
      "tablet_columns": 1,
      "mobile_columns": 1,
      "stacking_order": "source"
    },
    "interactions": [],
    "native_component_ratio": 1.0,
    "supported_modifiers": [
      "band-color",
      "content-width",
      "spacing",
      "text-alignment"
    ]
  },
  "template": {
    "type": "section",
    "classes": [
      {"name": "vj-section", "active": false},
      {"name": "py-5", "active": false}
    ],
    "attributes": {"id": "tpl-rtx-s1"},
    "components": [
      {
        "type": "grid",
        "classes": [
          {"name": "container", "active": false}
        ],
        "attributes": {"id": "tpl-rtx-g1"},
        "components": [
          {
            "type": "row",
            "classes": [
              {"name": "row", "active": false}
            ],
            "attributes": {"id": "tpl-rtx-r1"},
            "components": [
              {
                "type": "column",
                "classes": [
                  {"name": "col-12", "active": false}
                ],
                "attributes": {"id": "tpl-rtx-c1"},
                "components": [
                  {
                    "type": "heading",
                    "tagName": "h2",
                    "content": "Heading Text",
                    "classes": [
                      {"name": "vj-heading", "active": false},
                      {"name": "head-style-2", "active": false},
                      {"name": "mb-4", "active": false}
                    ],
                    "attributes": {"id": "tpl-rtx-h1"}
                  },
                  {
                    "type": "image",
                    "classes": [
                      {"name": "image-box", "active": false},
                      {"name": "vj-image", "active": false},
                      {"name": "img-fluid", "active": false},
                      {"name": "mb-4", "active": false}
                    ],
                    "attributes": {
                      "id": "tpl-rtx-i1",
                      "src": "https://placehold.co/1200x600",
                      "alt": "Section image"
                    }
                  },
                  {
                    "type": "text",
                    "tagName": "p",
                    "content": "Paragraph of text content.",
                    "classes": [
                      {"name": "vj-text", "active": false},
                      {"name": "paragraph-style-1", "active": false}
                    ],
                    "attributes": {"id": "tpl-rtx-t1"}
                  },
                  {
                    "type": "text",
                    "tagName": "p",
                    "content": "Paragraph of text content.",
                    "classes": [
                      {"name": "vj-text", "active": false},
                      {"name": "paragraph-style-1", "active": false}
                    ],
                    "attributes": {"id": "tpl-rtx-t2"}
                  },
                  {
                    "type": "text",
                    "tagName": "p",
                    "content": "Paragraph of text content.",
                    "classes": [
                      {"name": "vj-text", "active": false},
                      {"name": "paragraph-style-1", "active": false}
                    ],
                    "attributes": {"id": "tpl-rtx-t3"}
                  },
                  {
                    "type": "text",
                    "tagName": "p",
                    "content": "Paragraph of text content.",
                    "classes": [
                      {"name": "vj-text", "active": false},
                      {"name": "paragraph-style-1", "active": false}
                    ],
                    "attributes": {"id": "tpl-rtx-t4"}
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "styles": []
}
