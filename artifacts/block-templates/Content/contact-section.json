{
  "name": "Contact Section",
  "category": "Content",
  "description": "Two-column contact section with info (address, phone, email) on the left and a call-to-action on the right",
  "capabilities": {
    "schema_version": "1.1",
    "roles": [
      "contact",
      "contact_cta"
    ],
    "layout": {
      "kind": "split",
      "columns": [
        2
      ],
      "media_positions": [
        "none"
      ],
      "alignment": [
        "left"
      ]
    },
    "repeat_group": null,
    "fields": {
      "section_title": "required",
      "section_body": "optional",
      "contact_items": "optional",
      "action_title": "optional",
      "action_body": "optional",
      "action": "optional"
    },
    "physical_fields": {
