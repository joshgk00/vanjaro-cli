{
  "name": "FAQ Accordion",
  "category": "Content",
  "description": "Question-and-answer list with 5 pairs — for FAQ pages, knowledge bases, and support sections",
  "capabilities": {
    "schema_version": "1.1",
    "roles": [
      "faq",
      "question_answer"
    ],
    "layout": {
      "kind": "accordion",
      "columns": [
        1
      ],
      "media_positions": [
        "none"
      ],
      "alignment": [
        "left"
      ]
    },
    "repeat_group": {
      "kind": "faq_item",
      "minimum": 1,
      "default": 5,
      "maximum": null,
      "expandable": true
    },
    "fields": {
      "section_title": "optional",
      "item.question": "required",
      "item.answer": "required"
    },
    "physical_fields": {
      "section_title": {
        "owner": "section",
        "slot_type": "heading",
        "slots": [
          "heading_1"
        ],
        "slots_per_owner": 1
      },
      "item.question": {
        "owner": "repeat_item",
        "slot_type": "heading",
        "slots": [
          "heading_2",
          "heading_3",
          "heading_4",
          "heading_5",
          "heading_6"
        ],
        "slots_per_owner": 1
      },
      "item.answer": {
        "owner": "repeat_item",
        "slot_type": "text",
        "slots": [
          "text_1",
          "text_2",
          "text_3",
          "text_4",
          "text_5"
        ],
        "slots_per_owner": 1
      }
    },
    "responsive": {
      "desktop_columns": 1,
      "tablet_columns": 1,
      "mobile_columns": 1,
      "stacking_order": "source"
    },
    "interactions": [
      "accordion"
    ],
    "native_component_ratio": 0.95,
    "supported_modifiers": [
      "band-color",
      "content-width",
      "spacing",
      "text-alignment",
      "divider"
    ]
  },
  "template": {
    "type": "section",
    "classes": [
      {"name": "vj-section", "active": false},
      {"name": "py-5", "active": false}
    ],
    "attributes": {"id": "tpl-faq-s1"},
    "components": [
      {
        "type": "grid",
        "classes": [
          {"name": "container", "active": false}
        ],
        "attributes": {"id": "tpl-faq-g1"},
        "components": [
          {
            "type": "row",
            "classes": [
              {"name": "row", "active": false},
              {"name": "mb-4", "active": false}
            ],
            "attributes": {"id": "tpl-faq-r0"},
            "components": [
              {
                "type": "column",
                "classes": [
                  {"name": "col-12", "active": false}
                ],
                "attributes": {"id": "tpl-faq-c0"},
                "components": [
                  {
                    "type": "heading",
                    "tagName": "h2",
                    "content": "Frequently Asked Questions",
                    "classes": [
                      {"name": "vj-heading", "active": false},
                      {"name": "head-style-2", "active": false},
                      {"name": "text-center", "active": false}
                    ],
                    "attributes": {"id": "tpl-faq-h0"}
                  }
                ]
              }
            ]
          },
          {
            "type": "row",
            "classes": [
              {"name": "row", "active": false}
            ],
            "attributes": {"id": "tpl-faq-r1"},
            "components": [
              {
                "type": "column",
                "classes": [
                  {"name": "col-xl-8", "active": false},
                  {"name": "col-12", "active": false},
                  {"name": "mx-auto", "active": false}
                ],
                "attributes": {"id": "tpl-faq-c1"},
                "components": [
                  {
                    "type": "heading",
