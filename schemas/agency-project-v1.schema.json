{
  "$defs": {
    "AgencyPack": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "AgencyPack",
      "type": "object"
    },
    "ApprovalGate": {
      "enum": [
        "plan",
        "portal_mutation",
        "publish",
        "launch"
      ],
      "title": "ApprovalGate",
      "type": "string"
    },
    "ApprovalRecord": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "gate": {
          "$ref": "#/$defs/ApprovalGate"
        },
        "status": {
          "$ref": "#/$defs/ApprovalStatus",
          "default": "pending"
        },
        "fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "requested_by": {
          "minLength": 1,
          "title": "Requested By",
          "type": "string"
        },
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "resolved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved At"
        },
        "resolved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved By"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "id",
        "gate",
        "fingerprint",
        "requested_by",
        "requested_at"
      ],
      "title": "ApprovalRecord",
      "type": "object"
    },
    "ApprovalStatus": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "superseded"
      ],
      "title": "ApprovalStatus",
      "type": "string"
    },
    "AuditEvent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectStage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fingerprint": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "artifacts": {
          "items": {
            "type": "string"
          },
          "title": "Artifacts",
          "type": "array"
        }
      },
      "required": [
        "id",
        "occurred_at",
        "kind",
        "message"
      ],
      "title": "AuditEvent",
      "type": "object"
    },
    "BreakpointName": {
      "description": "Canonical responsive breakpoint names.",
      "enum": [
        "desktop",
        "tablet",
        "mobile"
      ],
      "title": "BreakpointName",
      "type": "string"
    },
    "DecisionRecord": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "topic": {
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        },
        "selection": {
          "minLength": 1,
          "title": "Selection",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "decided_by": {
          "minLength": 1,
          "title": "Decided By",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectStage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "topic",
        "selection",
        "decided_by",
        "decided_at"
      ],
      "title": "DecisionRecord",
      "type": "object"
    },
    "JsonValue": {},
    "ProjectIdentity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "created_at",
        "updated_at"
      ],
      "title": "ProjectIdentity",
      "type": "object"
    },
    "ProjectSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "reference": {
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "evidence_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Reference"
        },
        "page_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Reference"
        },
        "breakpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/BreakpointName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "viewport": {
          "anyOf": [
            {
              "$ref": "#/$defs/Viewport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "reference"
      ],
      "title": "ProjectSource",
      "type": "object"
    },
    "ProjectStage": {
      "enum": [
        "intake",
        "analyze",
        "plan",
        "theme",
        "assets",
        "library",
        "pages",
        "global_blocks",
        "verify",
        "publish",
        "launch"
      ],
      "title": "ProjectStage",
      "type": "string"
    },
    "SourceKind": {
      "description": "Supported origins for a Design Document.",
      "enum": [
        "live_html",
        "figma",
        "image",
        "legacy_sections",
        "composite"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "StageRecord": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "$ref": "#/$defs/ProjectStage"
        },
        "status": {
          "$ref": "#/$defs/StageStatus",
          "default": "pending"
        },
        "attempt": {
          "default": 0,
          "minimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "input_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Fingerprint"
        },
        "output_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Fingerprint"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "artifacts": {
          "items": {
            "type": "string"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        }
      },
      "required": [
        "stage"
      ],
      "title": "StageRecord",
      "type": "object"
    },
    "StageStatus": {
      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "skipped"
      ],
      "title": "StageStatus",
      "type": "string"
    },
    "TargetPortal": {
      "additionalProperties": false,
      "properties": {
        "profile": {
          "minLength": 1,
          "title": "Profile",
          "type": "string"
        },
        "expected_portal_id": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Portal Id"
        },
        "expected_base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Base Url"
        }
      },
      "required": [
        "profile"
      ],
      "title": "TargetPortal",
      "type": "object"
    },
    "Viewport": {
      "additionalProperties": false,
      "description": "Pixel dimensions used for a responsive observation.",
      "properties": {
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "Viewport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1",
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "project": {
      "$ref": "#/$defs/ProjectIdentity"
    },
    "target": {
      "$ref": "#/$defs/TargetPortal"
    },
    "agency_pack": {
      "$ref": "#/$defs/AgencyPack"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/ProjectSource"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "stages": {
      "additionalProperties": {
        "$ref": "#/$defs/StageRecord"
      },
      "propertyNames": {
        "$ref": "#/$defs/ProjectStage"
      },
      "title": "Stages",
      "type": "object"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/DecisionRecord"
      },
      "title": "Decisions",
      "type": "array"
    },
    "approvals": {
      "items": {
        "$ref": "#/$defs/ApprovalRecord"
      },
      "title": "Approvals",
      "type": "array"
    },
    "audit": {
      "items": {
        "$ref": "#/$defs/AuditEvent"
      },
      "title": "Audit",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "project",
    "target",
    "agency_pack",
    "sources",
    "stages",
    "decisions",
    "approvals",
    "audit",
    "metadata"
  ],
  "title": "Vanjaro Agency Project Manifest v1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clicksandmortars.com/schemas/agency-project-v1.schema.json",
  "description": "Versioned, secret-free workspace contract for resumable agency builds. Breaking changes require a new major schema."
}
