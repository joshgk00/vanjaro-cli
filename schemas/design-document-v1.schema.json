  "$id": "https://schemas.vanjaro.dev/design-document-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Version 1.0 rejects unknown fields. Minor versions may only add optional fields; breaking changes require a new major schema. Cross-reference and x-unique-by constraints are enforced by the DesignDocument model.",
  "properties": {
    "analysis": {
      "$ref": "#/$defs/DesignAnalysis"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/AssetRecord"
      },
      "title": "Assets",
      "type": "array",
      "x-unique-by": "id"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/Page"
      },
      "title": "Pages",
      "type": "array",
      "x-unique-by": "id"
    },
    "schema_version": {
      "pattern": "^1\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/DesignSource"
    },
    "tokens": {
      "$ref": "#/$defs/DesignTokens"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/DesignWarning"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "source",
    "tokens",
    "assets",
    "pages",
    "warnings",
    "analysis"
  ],
  "title": "Vanjaro Design Document v1",
  "type": "object",
  "x-validation-notes": [
    "Arrays marked x-unique-by use the id property as a uniqueness key.",
    "Element, asset, page, section, group, region, layer, interaction, and repeat-item IDs share a document-wide namespace.",
    "References are validated by vanjaro_cli.design.models.DesignDocument."
  ]
}
