{
  "$defs": {
    "Alignment": {
      "description": "Normalized content or item alignment.",
      "enum": [
        "left",
        "center",
        "right",
        "start",
        "end",
        "stretch",
        "space_between"
      ],
      "title": "Alignment",
      "type": "string"
    },
    "AssetKind": {
      "description": "Asset payload types referenced by design elements.",
      "enum": [
        "image",
        "video",
        "font",
        "svg",
        "document",
        "other"
      ],
      "title": "AssetKind",
      "type": "string"
    },
    "AssetRecord": {
      "additionalProperties": false,
      "description": "A de-duplicated source asset or explicit unresolved asset.",
      "properties": {
        "alt_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alt Text"
        },
        "height": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "local_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Path"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "mime_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mime Type"
        },
        "missing_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "role": {
          "$ref": "#/$defs/AssetRole"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "width": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        }
      },
      "required": [
        "id",
        "kind",
        "role"
      ],
      "title": "AssetRecord",
      "type": "object"
    },
    "AssetRole": {
      "description": "Whether an asset is editable content or visual decoration.",
      "enum": [
        "editorial",
        "decorative"
      ],
      "title": "AssetRole",
      "type": "string"
    },
    "BoundingBox": {
      "additionalProperties": false,
      "description": "Source geometry in CSS or Figma pixels.",
      "properties": {
        "height": {
          "minimum": 0,
          "title": "Height",
          "type": "number"
        },
        "width": {
          "minimum": 0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "BreakpointName": {
      "description": "Canonical responsive breakpoint names.",
      "enum": [
        "desktop",
        "tablet",
        "mobile"
      ],
      "title": "BreakpointName",
      "type": "string"
    },
    "CandidateRole": {
      "additionalProperties": false,
      "description": "Alternative semantic role considered for a section.",
      "properties": {
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "role",
        "score"
      ],
      "title": "CandidateRole",
      "type": "object"
    },
    "ConditionBound": {
      "additionalProperties": false,
      "description": "One bounded pixel-width comparison, e.g. ``max-width: 1023px``.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ResponsiveConditionKind"
        },
        "threshold_px": {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Threshold Px",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "threshold_px"
      ],
      "title": "ConditionBound",
      "type": "object"
    },
    "ContentElement": {
      "additionalProperties": false,
      "description": "Visitor-facing content with semantic ownership and provenance.",
      "properties": {
        "asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "attributes": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Attributes",
          "type": "object"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Id"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ContentKind"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "style": {
          "$ref": "#/$defs/StyleSet"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "kind",
        "role",
        "order",
        "provenance",
        "confidence"
      ],
      "title": "ContentElement",
      "type": "object"
    },
    "ContentKind": {
      "description": "Visitor-facing element kinds defined by Design Document v1.",
      "enum": [
        "heading",
        "text",
        "image",
        "button",
        "link",
        "list",
        "list_item",
        "quote",
        "stat",
        "video",
        "form_placeholder",
        "other"
      ],
      "title": "ContentKind",
      "type": "string"
    },
    "DecorativeLayer": {
      "additionalProperties": false,
      "description": "Non-editorial visual layer associated with a section.",
      "properties": {
        "asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "style": {
          "$ref": "#/$defs/StyleSet"
        }
      },
      "required": [
        "id",
        "kind",
        "order",
        "provenance",
        "confidence"
      ],
      "title": "DecorativeLayer",
      "type": "object"
    },
    "DesignAnalysis": {
      "additionalProperties": false,
      "description": "Aggregate quality signals produced during design analysis.",
      "properties": {
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "section_confidence_mean": {
          "maximum": 1,
          "minimum": 0,
          "title": "Section Confidence Mean",
          "type": "number"
        },
        "unsupported_traits": {
          "items": {
            "type": "string"
          },
          "title": "Unsupported Traits",
          "type": "array"
        }
      },
      "required": [
        "section_confidence_mean",
        "unsupported_traits"
      ],
      "title": "DesignAnalysis",
      "type": "object"
    },
    "DesignSource": {
      "additionalProperties": false,
      "description": "Identity and capture metadata for the input design.",
      "properties": {
        "adapter_version": {
          "minLength": 1,
          "title": "Adapter Version",
          "type": "string"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "identifier": {
          "minLength": 1,
          "title": "Identifier",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "identifier",
        "captured_at",
        "adapter_version"
      ],
      "title": "DesignSource",
      "type": "object"
    },
    "DesignTokens": {
      "additionalProperties": false,
      "description": "Source-level visual tokens shared across pages.",
      "properties": {
        "colors": {
          "additionalProperties": {
            "$ref": "#/$defs/TokenValue"
          },
          "title": "Colors",
          "type": "object"
        },
        "raw": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Raw",
          "type": "object"
        },
        "spacing": {
          "additionalProperties": {
            "$ref": "#/$defs/TokenValue"
          },
          "title": "Spacing",
          "type": "object"
        },
        "typography": {
          "items": {
            "$ref": "#/$defs/TypographyToken"
          },
          "title": "Typography",
          "type": "array"
        }
      },
      "title": "DesignTokens",
      "type": "object"
    },
    "DesignWarning": {
      "additionalProperties": false,
      "description": "Non-fatal extraction or translation issue.",
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/WarningSeverity",
          "default": "warning"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "DesignWarning",
      "type": "object"
    },
    "EvidenceStatus": {
      "description": "Whether evidence was directly observed or inferred.",
      "enum": [
        "observed",
        "inferred"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "Interaction": {
      "additionalProperties": false,
      "description": "Source interaction inventory and native-representation status.",
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/InteractionKind"
        },
        "native_representation_known": {
          "title": "Native Representation Known",
          "type": "boolean"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus",
          "default": "observed"
        },
        "target_element_ids": {
          "items": {
            "type": "string"
          },
          "title": "Target Element Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "native_representation_known",
        "provenance",
        "confidence"
      ],
      "title": "Interaction",
      "type": "object"
    },
    "InteractionKind": {
      "description": "Interactions that can be inventoried without copying source scripts.",
      "enum": [
        "accordion",
        "tabs",
        "carousel",
        "video_embed",
        "menu",
        "form",
        "modal_trigger",
        "other"
      ],
      "title": "InteractionKind",
      "type": "string"
    },
    "JsonValue": {},
    "LayoutKind": {
      "description": "Common source-neutral section and region layouts.",
      "enum": [
        "stack",
        "grid",
        "flex",
        "split",
        "carousel",
        "freeform",
        "other"
      ],
      "title": "LayoutKind",
      "type": "string"
    },
    "LayoutObservation": {
      "additionalProperties": false,
      "description": "Normalized base layout for a section or nested region.",
      "properties": {
        "alignment": {
          "anyOf": [
            {
              "$ref": "#/$defs/Alignment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "columns": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Columns"
        },
        "contained": {
          "title": "Contained",
          "type": "boolean"
        },
        "direction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "full_bleed": {
          "default": false,
          "title": "Full Bleed",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/LayoutKind"
        },
        "media_position": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaPosition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "wrap": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wrap"
        }
      },
      "required": [
        "kind",
        "contained"
      ],
      "title": "LayoutObservation",
      "type": "object"
    },
    "LayoutRegion": {
      "additionalProperties": false,
      "description": "A nested non-repeating owner for content elements.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "layout": {
          "$ref": "#/$defs/LayoutObservation"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "parent_region_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Region Id"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "id",
        "role",
        "order",
        "layout"
      ],
      "title": "LayoutRegion",
      "type": "object"
    },
    "MediaPosition": {
      "description": "Position of editorial media relative to primary content.",
      "enum": [
        "top",
        "right",
        "bottom",
        "left",
        "background",
        "none"
      ],
      "title": "MediaPosition",
      "type": "string"
    },
    "NavigationVisibility": {
      "description": "Page-level navigation state captured from the source.",
      "enum": [
        "visible",
        "hidden",
        "unknown"
      ],
      "title": "NavigationVisibility",
      "type": "string"
    },
    "ObservationMethod": {
      "description": "Mechanism that produced a provenance record.",
      "enum": [
        "static",
        "rendered",
        "api",
        "inferred",
        "legacy",
        "manual"
      ],
      "title": "ObservationMethod",
      "type": "string"
    },
    "Page": {
      "additionalProperties": false,
      "description": "A source page or page-like Figma frame.",
      "properties": {
        "breakpoints": {
          "items": {
            "$ref": "#/$defs/BreakpointName"
          },
          "title": "Breakpoints",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "navigation_visibility": {
          "$ref": "#/$defs/NavigationVisibility"
        },
        "parent_page_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Page Id"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "title": "Sections",
          "type": "array",
          "x-unique-by": "id"
        },
        "seo": {
          "anyOf": [
            {
              "$ref": "#/$defs/SeoMetadata"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "slug": {
          "title": "Slug",
          "type": "string"
        },
        "source_reference": {
          "minLength": 1,
          "title": "Source Reference",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_reference",
        "title",
        "slug",
        "sections",
        "breakpoints",
        "navigation_visibility",
        "provenance"
      ],
      "title": "Page",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Trace from inferred design data back to HTML or Figma evidence.",
      "properties": {
        "bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundingBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "component_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Component Id"
        },
        "css_selector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Css Selector"
        },
        "element_node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Element Node Id"
        },
        "file_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Key"
        },
        "frame_node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Node Id"
        },
        "instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instance Id"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "method": {
          "$ref": "#/$defs/ObservationMethod"
        },
        "page_node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Node Id"
        },
        "source_attribute": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Attribute"
        },
        "source_kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "viewport": {
          "anyOf": [
            {
              "$ref": "#/$defs/BreakpointName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "source_kind",
        "method"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RepeatGroup": {
      "additionalProperties": false,
