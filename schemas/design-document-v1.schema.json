          "default": null,
          "title": "Hidden"
        },
        "layout_changes": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Layout Changes",
          "type": "object"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "section_condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResponsiveCondition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "style": {
          "$ref": "#/$defs/StyleSet"
        },
        "viewport": {
          "$ref": "#/$defs/Viewport"
        }
      },
      "required": [
        "breakpoint",
        "viewport",
        "status"
      ],
      "title": "ResponsiveObservation",
      "type": "object"
    },
